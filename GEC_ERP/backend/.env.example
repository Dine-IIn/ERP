# =================================================================
# GEC ERP - CENTRAL BACKEND SERVER TEMPLATE (.env.example)
# =================================================================

PORT=5000
NODE_ENV=production

# Database Connection (Default PostgreSQL Local Engine)
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=gec_erp

# Storage & Backups (Defaults to {app}/storage and {app}/backups)
# STORAGE_DIR=
# BACKUP_DIR=

AUTO_BACKUP_CYCLE_HOURS=48
BACKUP_RETENTION_DAYS=0

CORS_ORIGIN=*
SUPERADMIN_MASTER_KEY=GEC_SuperAdmin#2026!Secured$
JWT_SECRET=gec_moulding_machine_enterprise_secret_key_2026
GITHUB_REPO=Dine-IIn/ERP
