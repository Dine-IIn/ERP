NODE_ENV=development
APP_PORT=3000
APP_NAME=Enterprise ERP
API_PREFIX=api
API_VERSION=v1

MASTER_DATABASE_URL=postgresql://erp:erp@postgres:5432/erp_master
POSTGRES_USER=erp
POSTGRES_PASSWORD=erp
POSTGRES_DB=erp_master

REDIS_HOST=redis
REDIS_PORT=6379

JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

STORAGE_PROVIDER=local
LOCAL_STORAGE_ROOT=/var/lib/erp/storage

SENTRY_DSN=
FCM_SERVER_KEY=
