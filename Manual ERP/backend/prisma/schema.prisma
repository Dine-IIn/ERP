datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Company {
  id               String           @id @default(uuid())
  companyCode      String           @unique
  name             String
  status           String           @default("ACTIVE")
  subscriptionTier String           @default("BASIC")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  users            User[]
  roles            Role[]
  features         CompanyFeature[]

  // --- EXTENSION: COMPANY PROFILE & SETTINGS ---
  legalCompanyName    String?
  companyLogo         String?
  fileSizeLimit       Int?    @default(50)
  backupAccess        Boolean @default(false)
  backupRetentionDays Int?    @default(60)
  autoBackupInterval  Int?    @default(2)
  companyEmail        String?
  companyPhone        String?
  alternatePhone      String?
  website             String?
  industryType        String?
  businessType        String?
  companyDescription  String?

  // SMTP Settings for Email Integration
  smtpHost     String?
  smtpPort     Int?
  smtpUser     String?
  smtpPassword String?
  smtpSecure   Boolean @default(false)
  smtpSender   String?

  // Tax Info
  gstin      String?
  pan        String?
  tan        String?
  vatNumber  String?
  cinNumber  String?
  msmeNumber String?

  // Address
  country      String?
  state        String?
  city         String?
  pincode      String?
  addressLine1 String?
  addressLine2 String?
  landmark     String?

  // Business Details
  fiscalYearStart  String?
  fiscalYearEnd    String?
  currencyId       String?
  timezone         String?
  dateFormat       String?
  language         String?
  decimalPrecision Int?    @default(2)

  // Branding
  primaryColor    String?
  secondaryColor  String?
  dashboardTheme  String? @default("dark")
  favicon         String?
  invoiceTemplate String? @default("STANDARD")

  // Relations
  auditLogs   AuditLog[]
  departments Department[]
  customers         Customer[]
  vendors           Vendor[]
  productCategories ProductCategory[]
  brands            Brand[]
  products          Product[]
  salesOrders       SalesOrder[]
  proformaInvoices  ProformaInvoice[]
  salesInvoices     SalesInvoice[]
  deliveryChallans  DeliveryChallan[]
  documentTemplates DocumentTemplate[]
  dispatches        Dispatch[]
  taxes             Tax[]
  leads             Lead[]
  opportunities     Opportunity[]
  followups         FollowUp[]
  quotations        Quotation[]
  serviceTickets    ServiceTicket[]
  vendorQuotations  VendorQuotation[]
  purchaseOrders    PurchaseOrder[]
  grns              Grn[]
  purchaseReturns   PurchaseReturn[]
  vendorPayments    VendorPayment[]
  stockAdjustments  StockAdjustment[]

  // Manufacturing relations
  boms                 BillOfMaterials[]
  productionPlans      ProductionPlan[]
  workOrders           WorkOrder[]
  jobCards             JobCard[]
  productionLogs       ProductionLog[]
  qcRecords            QualityControlRecord[]
  reworkCards          ReworkCard[]
  workCenters          WorkCenter[]
  factoryShifts        FactoryShift[]

  // HRMS & Finance Extensions
  attendances       Attendance[]
  leaveRequests     LeaveRequest[]
  shiftRosters      ShiftRoster[]
  payrollPeriods    PayrollPeriod[]
  companyExpenses   CompanyExpense[]
  companyReceipts   CompanyReceipt[]
  cashbookVouchers  CashbookVoucher[]
  bankAccounts      CompanyBankAccount[]

  // AI Forecasting extensions
  forecastConfigurations ForecastConfigurations?
  forecastStatus         ForecastStatus?
  forecastHistory        ForecastHistory[]
  forecastPredictions    ForecastPrediction[]
  forecastJobs           ForecastJob[]

  @@map("companies")
}

model Feature {
  id          String           @id @default(uuid())
  key         String           @unique
  name        String
  description String?
  companies   CompanyFeature[]

  @@map("features")
}

model CompanyFeature {
  companyId String
  featureId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  feature   Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@id([companyId, featureId])
  @@map("company_features")
}

model Role {
  id          String   @id @default(uuid())
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  permissions String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]

  @@unique([companyId, name])
  @@map("roles")
}

model User {
  id                String         @id @default(uuid())
  companyId         String
  company           Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  username          String
  passwordHash      String
  mobileNo          String         @unique
  email             String?
  status            String         @default("PENDING_APPROVAL")
  hasBackupAccess   Boolean        @default(false)
  roleId            String?
  role              Role?          @relation(fields: [roleId], references: [id], onDelete: SetNull)
  departmentId      String?
  department        Department?    @relation("DepartmentUsers", fields: [departmentId], references: [id], onDelete: SetNull)
  managedDepartment Department?    @relation("DepartmentManager")
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  pushTokens        PushToken[]
  notifications     Notification[]
  sessions          UserSession[]

  // Employee Master Extensions
  reportsToId       String?
  reportsTo         User?         @relation("UserHierarchy", fields: [reportsToId], references: [id])
  subordinates      User[]        @relation("UserHierarchy")
  shiftStart        String?
  shiftEnd          String?
  shiftName         String?
  documents         String?
  assignedLeads     Lead[]

  // HRMS & Finance Relations
  attendances       Attendance[]
  leaveRequests     LeaveRequest[]  @relation("UserLeaves")
  approvedLeaves    LeaveRequest[]  @relation("ApprovedLeaves")
  payrollPeriods    PayrollPeriod[]
  paidExpenses      CompanyExpense[]

  // Manufacturing Relations
  assignedJobCards    JobCard[]      @relation("AssignedOperator")
  assignedReworkCards ReworkCard[]   @relation("AssignedReworkOperator")
  factoryShifts       FactoryShift[]

  @@unique([companyId, username])
  @@map("users")
}

model UserSession {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceType   String   // "DESKTOP" or "MOBILE"
  deviceModel  String?  // e.g. "Chrome Browser", "Android Phone"
  token        String   @unique
  lastActiveAt DateTime @default(now())
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@map("user_sessions")
}

model OTPVerification {
  id        String   @id @default(uuid())
  target    String
  otpCode   String
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("otp_verifications")
}

model PushToken {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceToken String   @unique
  platform    String
  updatedAt   DateTime @updatedAt

  @@map("push_tokens")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  category  String
  channels  String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  description String?
  type        String?
  priority    String? @default("MEDIUM")
  module      String?
  redirectUrl String?
  companyId   String?
  isArchived  Boolean @default(false)

  @@map("notifications")
}

model ChatGroup {
  id          String   @id @default(uuid())
  companyId   String
  name        String
  type        String
  createdById String
  settings    String   @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId])
  @@map("chat_groups")
}

model GroupMember {
  id        String   @id @default(uuid())
  groupId   String
  userId    String
  role      String   @default("MEMBER")
  createdAt DateTime @default(now())

  @@unique([groupId, userId])
  @@index([userId])
  @@map("group_members")
}

model ChatMessage {
  id          String   @id @default(uuid())
  groupId     String
  senderId    String
  senderName  String
  message     String
  type        String   @default("TEXT")
  expenseData String?
  createdAt   DateTime @default(now())

  @@index([groupId])
  @@index([createdAt])
  @@map("chat_messages")
}

model AuditLog {
  id         String   @id @default(uuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId     String?
  username   String?
  moduleName String
  actionType String
  oldValue   String?
  newValue   String?
  ipAddress  String?
  deviceInfo String?
  timestamp  DateTime @default(now())

  @@index([companyId])
  @@index([timestamp])
  @@map("audit_logs")
}

model Department {
  id          String   @id @default(uuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  description String?
  features    String   @default("[]") // JSON stringified array of feature keys
  managerId   String?  @unique
  manager     User?    @relation("DepartmentManager", fields: [managerId], references: [id], onDelete: SetNull)
  users       User[]   @relation("DepartmentUsers")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([companyId, name])
  @@map("departments")
}

model Customer {
  id              String   @id @default(uuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name            String
  customerType    String   // "INDIVIDUAL" or "COMPANY"
  customerGroup   String?  // e.g. "RETAILER", "WHOLESALER"
  contactPerson   String?
  contactNo       String
  email           String?
  billingAddress  String?
  shippingAddress String?
  creditLimit     Float    @default(0.0)
  creditTime      Int      @default(0)
  clientClassification String?  @default("NATIONAL") // "NATIONAL" or "INTERNATIONAL"
  state           String   @default("Gujarat")
  country         String   @default("India")
  currencySymbol  String   @default("$")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  bankName             String?
  accountHolderName    String?
  accountNumber        String?
  ifscCode             String?
  gstNumber            String?
  panNumber            String?
  salesOrders     SalesOrder[]
  proformaInvoices ProformaInvoice[]
  salesInvoices   SalesInvoice[]
  deliveryChallans DeliveryChallan[]
  quotations      Quotation[]
  serviceTickets  ServiceTicket[]

  @@unique([companyId, name])
  @@map("customers")
}

model Vendor {
  id           String   @id @default(uuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String
  isVendor     Boolean  @default(true) // true = Vendor, false = Supplier
  contactNo    String
  email        String?
  bankDetails  String?
  paymentTerms String?
  gstDetails   String?
  creditTime   Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  bankName             String?
  accountHolderName    String?
  accountNumber        String?
  ifscCode             String?
  gstNumber            String?
  panNumber            String?
  currencySymbol       String   @default("$")
  currencyId           String   @default("USD")
  vendorQuotations VendorQuotation[]
  purchaseOrders   PurchaseOrder[]
  vendorPayments   VendorPayment[]
  routingOperations RoutingOperation[]
  jobCards          JobCard[]        @relation("JobCardVendor")

  @@unique([companyId, name])
  @@map("vendors")
}

model ProductCategory {
  id        String    @id @default(uuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  products  Product[]
  createdAt DateTime  @default(now())

  @@unique([companyId, name])
  @@map("product_categories")
}

model Brand {
  id        String    @id @default(uuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  products  Product[]
  createdAt DateTime  @default(now())

  @@unique([companyId, name])
  @@map("brands")
}

model Product {
  id           String           @id @default(uuid())
  companyId    String
  company      Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String
  categoryId   String?
  category     ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brandId      String?
  brand        Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  uom          String
  pricing      Float            @default(0.0)
  hsnSacCode   String?
  imageUrl     String?
  bomReference String?
  moq          Float            @default(1.0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  variants     ProductVariant[]
  salesOrderItems      SalesOrderItem[]
  proformaInvoiceItems ProformaInvoiceItem[]
  salesInvoiceItems    SalesInvoiceItem[]
  deliveryChallanItems DeliveryChallanItem[]

  // --- INVENTORY MANAGEMENT ADDITIONS ---
  stock            Float            @default(0.0)   // Active physical stock level
  quarantineStock  Float            @default(0.0)   // Raw materials in incoming quality quarantine hold
  reorderLevel     Float            @default(5.0)   // Alert threshold for low stock
  warehouseLoc     String?          // Warehouse rack designation, e.g. "Rack A-3"
  quotationItems       QuotationItem[]
  serviceTickets       ServiceTicket[]
  vendorQuotationItems VendorQuotationItem[]
  purchaseOrderItems   PurchaseOrderItem[]
  grnItems             GrnItem[]
  purchaseReturnItems  PurchaseReturnItem[]
  stockAdjustments     StockAdjustment[]

  // Manufacturing Relations
  finishedBoms BillOfMaterials[] @relation("FinishedProductBOM")
  componentBoms BomComponent[] @relation("ComponentProductBOM")
  productionPlans ProductionPlan[]
  qcRecords QualityControlRecord[]
  reworkCards ReworkCard[]
  routing Routing?
  materialIssues MaterialIssue[]
  forecastPredictions ForecastPrediction[]

  @@unique([companyId, name])
  @@index([categoryId])
  @@index([brandId])
  @@map("products")
}

model ProductVariant {
  id         String   @id @default(uuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name       String
  sku        String?  @unique
  priceAddon Float    @default(0.0)
  createdAt  DateTime @default(now())

  @@map("product_variants")
}

model SalesOrder {
  id           String           @id @default(uuid())
  companyId    String
  company      Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId   String
  customer     Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderNo      String
  orderDate    DateTime         @default(now())
  deliveryDate DateTime?
  discount     Float            @default(0.0)
  discountType String           @default("PERCENTAGE") // "PERCENTAGE" or "AMOUNT"
  status       String           @default("PENDING") // PENDING, DISPATCHED, COMPLETED, CANCELLED
  items        SalesOrderItem[]
  dispatches   Dispatch[]
  billingAddress            String?
  shippingAddress           String?
  shippingState             String?
  shippingName              String?
  customerName              String?
  customerContactNo         String?
  customerEmail             String?
  customerBankName          String?
  customerAccountHolderName String?
  customerAccountNumber     String?
  customerIfscCode          String?
  customerGstNumber         String?
  customerPanNumber         String?
  templateSettings          String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  // Manufacturing Relations
  productionPlans ProductionPlan[]

  @@unique([companyId, orderNo])
  @@index([customerId])
  @@map("sales_orders")
}

model SalesOrderItem {
  id           String     @id @default(uuid())
  orderId      String
  order        SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity     Float
  price        Float
  deliveryDate DateTime?
  discount     Float      @default(0.0)
  billedQty    Float      @default(0.0)

  @@map("sales_order_items")
}

model ProformaInvoice {
  id         String               @id @default(uuid())
  companyId  String
  company    Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  invoiceNo  String
  date       DateTime             @default(now())
  dueDate    DateTime?
  subtotal   Float
  discount   Float                @default(0.0)
  discountType String             @default("PERCENTAGE") // "PERCENTAGE" or "AMOUNT"
  tax        Float                @default(0.0)
  total      Float
  status     String               @default("DRAFT") // DRAFT, SENT, PAID, CANCELLED
  items      ProformaInvoiceItem[]
  billingAddress            String?
  shippingAddress           String?
  shippingState             String?
  shippingName              String?
  customerName              String?
  customerContactNo         String?
  customerEmail             String?
  customerBankName          String?
  customerAccountHolderName String?
  customerAccountNumber     String?
  customerIfscCode          String?
  customerGstNumber         String?
  customerPanNumber         String?
  templateSettings          String?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@unique([companyId, invoiceNo])
  @@map("proforma_invoices")
}

model ProformaInvoiceItem {
  id         String          @id @default(uuid())
  invoiceId  String
  invoice    ProformaInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId  String
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity   Float
  price      Float
  discount   Float           @default(0.0)

  @@map("proforma_invoice_items")
}

model SalesInvoice {
  id              String             @id @default(uuid())
  companyId       String
  company         Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId      String
  customer        Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  invoiceNo       String
  date            DateTime           @default(now())
  dueDate         DateTime?
  subtotal        Float
  discount        Float              @default(0.0)
  discountType    String             @default("PERCENTAGE") // "PERCENTAGE" or "AMOUNT"
  tax             Float              @default(0.0)
  total           Float
  status          String             @default("UNPAID") // UNPAID, PARTIAL, PAID, OVERDUE, CANCELLED
  items           SalesInvoiceItem[]
  billingAddress  String?
  shippingAddress String?
  shippingState   String?
  shippingName    String?
  salesOrderId    String?
  salesOrderIds   String?            // JSON string for merged Sales Orders
  customerName              String?
  customerContactNo         String?
  customerEmail             String?
  customerBankName          String?
  customerAccountHolderName String?
  customerAccountNumber     String?
  customerIfscCode          String?
  customerGstNumber         String?
  customerPanNumber         String?
  templateSettings          String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([companyId, invoiceNo])
  @@map("sales_invoices")
}

model SalesInvoiceItem {
  id               String       @id @default(uuid())
  invoiceId        String
  invoice          SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId        String
  product          Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity         Float
  price            Float
  discount         Float        @default(0.0)
  salesOrderItemId String?      // Links to which SalesOrderItem this line item bills

  @@map("sales_invoice_items")
}

model DeliveryChallan {
  id              String                 @id @default(uuid())
  companyId       String
  company         Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId      String
  customer        Customer               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  challanNo       String
  date            DateTime               @default(now())
  status          String                 @default("ISSUED") // ISSUED, RECEIVED, RETURNED, CANCELLED
  items           DeliveryChallanItem[]
  salesOrderId    String?
  salesOrderIds   String?                // JSON string for merged Sales Orders
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@unique([companyId, challanNo])
  @@map("delivery_challans")
}

model DeliveryChallanItem {
  id        String          @id @default(uuid())
  challanId String
  challan   DeliveryChallan @relation(fields: [challanId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Float
  price     Float           @default(0.0)

  @@map("delivery_challan_items")
}

model Dispatch {
  id             String      @id @default(uuid())
  companyId      String
  company        Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orderId        String
  order          SalesOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  dispatchNo     String
  dispatchDate   DateTime    @default(now())
  carrier        String?
  trackingNo     String?
  vehicleNo      String?
  shippingCost   Float       @default(0.0)
  status         String      @default("SHIPPED") // SHIPPED, IN_TRANSIT, DELIVERED, RETURNED
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([companyId, dispatchNo])
  @@map("dispatches")
}

// ==========================================
// NEW ERP EXPANSION MODELS
// ==========================================

model Tax {
  id         String   @id @default(uuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name       String   // e.g. "GST 18%", "VAT 5%"
  rate       Float    // e.g. 18.0, 5.0
  type       String   // "GST", "VAT", "SALES_TAX", "SERVICE_TAX"
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([companyId, name])
  @@map("taxes")
}

model Lead {
  id             String   @id @default(uuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name           String   // Contact name
  companyName    String?  // Associated company
  email          String?
  phone          String
  source         String   // "WEBSITE", "REFERRAL", "COLD_CALL", "EXHIBITION", "OTHER"
  status         String   // "NEW", "CONTACTED", "QUALIFIED", "LOST"
  assignedToId   String?
  assignedTo     User?    @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  opportunities  Opportunity[]
  followups      FollowUp[]

  @@map("leads")
}

model Opportunity {
  id             String   @id @default(uuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  leadId         String
  lead           Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  title          String   // e.g. "100 Tons Copper Wire Supply"
  value          Float    // Estimated deal value
  stage          String   // "PROSPECTING", "PROPOSAL", "NEGOTIATION", "WON", "LOST"
  probability    Float    // Conversion percentage probability (e.g. 20, 50, 90)
  closeDate      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("opportunities")
}

model FollowUp {
  id             String   @id @default(uuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  leadId         String
  lead           Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  scheduledDate  DateTime
  type           String   // "CALL", "EMAIL", "MEETING", "DEMO"
  status         String   // "PENDING", "COMPLETED", "CANCELLED"
  notes          String?
  outcome        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("followups")
}

model Quotation {
  id           String          @id @default(uuid())
  companyId    String
  company      Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId   String
  customer     Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  quoteNo      String
  date         DateTime        @default(now())
  expiryDate   DateTime?
  subtotal     Float
  discount     Float           @default(0.0) // percentage
  tax          Float           @default(0.0)
  total        Float
  status       String          @default("DRAFT") // DRAFT, SENT, ACCEPTED, REJECTED, EXPIRED
  items        QuotationItem[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([companyId, quoteNo])
  @@map("quotations")
}

model QuotationItem {
  id          String    @id @default(uuid())
  quoteId     String
  quotation   Quotation @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity    Float
  price       Float
  discount    Float     @default(0.0)

  @@map("quotation_items")
}

model ServiceTicket {
  id             String   @id @default(uuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  serialNumber   String?
  ticketNo       String
  title          String   // ticket summary
  type           String   // "MAINTENANCE", "REPAIR", "INSTALLATION", "WARRANTY_CLAIM"
  priority       String   // "LOW", "MEDIUM", "HIGH", "CRITICAL"
  status         String   // "OPEN", "IN_PROGRESS", "RESOLVED", "CLOSED"
  scheduledDate  DateTime?
  resolutionNotes String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([companyId, ticketNo])
  @@map("service_tickets")
}

model VendorQuotation {
  id             String                 @id @default(uuid())
  companyId      String
  company        Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vendorId       String
  vendor         Vendor                 @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  quoteNo        String
  date           DateTime               @default(now())
  validUntil     DateTime?
  subtotal       Float
  tax            Float                  @default(0.0)
  total          Float
  status         String                 @default("PENDING") // PENDING, ACCEPTED, REJECTED
  items          VendorQuotationItem[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@unique([companyId, quoteNo])
  @@map("vendor_quotations")
}

model VendorQuotationItem {
  id          String          @id @default(uuid())
  quoteId     String
  quotation   VendorQuotation @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId   String
  product     Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity    Float
  price       Float

  @@map("vendor_quotation_items")
}

model PurchaseOrder {
  id           String              @id @default(uuid())
  companyId    String
  company      Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vendorId     String
  vendor       Vendor              @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  poNo         String
  date         DateTime            @default(now())
  deliveryDate DateTime?
  subtotal     Float
  discount     Float               @default(0.0) // percentage
  tax          Float               @default(0.0)
  total        Float
  status       String              @default("PENDING") // PENDING, APPROVED, SHIPPED, COMPLETED
  items        PurchaseOrderItem[]
  grns         Grn[]
  returns      PurchaseReturn[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  // Outsource / Subcontract Relations
  isSubcontract Boolean            @default(false)
  workOrderId   String?
  workOrder     WorkOrder?         @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  jobCardId     String?
  jobCard       JobCard?           @relation(fields: [jobCardId], references: [id], onDelete: SetNull)

  @@unique([companyId, poNo])
  @@index([vendorId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id          String        @id @default(uuid())
  poId        String
  po          PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  productId   String
  product     Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity    Float
  price       Float
  discount    Float         @default(0.0)

  @@map("purchase_order_items")
}

model Grn {
  id             String     @id @default(uuid())
  companyId      String
  company        Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  poId           String
  purchaseOrder  PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  grnNo          String
  receivedDate   DateTime   @default(now())
  receivedBy     String?
  gateEntryNo    String?
  challanNo      String?
  status         String     @default("RECEIVED") // RECEIVED, INSPECTED, REJECTED
  notes          String?
  items          GrnItem[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([companyId, grnNo])
  @@index([poId])
  @@map("grns")
}

model GrnItem {
  id          String   @id @default(uuid())
  grnId       String
  grn         Grn      @relation(fields: [grnId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  qtyOrdered  Float
  qtyReceived Float
  qtyAccepted Float
  qtyRejected Float    @default(0.0)

  @@map("grn_items")
}

model PurchaseReturn {
  id             String               @id @default(uuid())
  companyId      String
  company        Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  poId           String
  purchaseOrder  PurchaseOrder        @relation(fields: [poId], references: [id], onDelete: Cascade)
  returnNo       String
  returnDate     DateTime             @default(now())
  reason         String
  status         String               @default("PENDING") // PENDING, SENT, COMPLETED
  items          PurchaseReturnItem[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([companyId, returnNo])
  @@map("purchase_returns")
}

model PurchaseReturnItem {
  id          String         @id @default(uuid())
  returnId    String
  pret        PurchaseReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  productId   String
  product     Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity    Float
  price       Float

  @@map("purchase_return_items")
}

model VendorPayment {
  id             String   @id @default(uuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vendorId       String
  vendor         Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  paymentNo      String
  paymentDate    DateTime @default(now())
  amount         Float
  paymentMethod  String   // "BANK_TRANSFER", "CASH", "CHEQUE", "UPI", "CREDIT_CARD"
  referenceNo    String?  // Bank transfer / UPI reference
  bankDetails    String?
  status         String   @default("COMPLETED") // PENDING, COMPLETED, FAILED
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([companyId, paymentNo])
  @@map("vendor_payments")
}

model StockAdjustment {
  id             String   @id @default(uuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  adjustmentNo   String
  date           DateTime @default(now())
  type           String   // "INWARD_PO", "OUTWARD_SO", "INWARD_RETURN", "OUTWARD_RETURN", "MANUAL_ADD", "MANUAL_SUB"
  quantity       Float    // Positive/Negative
  previousStock  Float
  newStock       Float
  reason         String?
  referenceNo    String?
  createdAt      DateTime @default(now())

  @@unique([companyId, adjustmentNo])
  @@map("stock_adjustments")
}

model Attendance {
  id           String   @id @default(uuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date         DateTime @default(now())
  checkIn      DateTime
  checkOut     DateTime?
  duration     Float?   // worked hours
  status       String   @default("PRESENT") // PRESENT, LATE, HALFDAY, ABSENT
  createdAt    DateTime @default(now())

  @@index([userId, date])
  @@map("attendances")
}

model LeaveRequest {
  id           String   @id @default(uuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation("UserLeaves", fields: [userId], references: [id], onDelete: Cascade)
  type         String   // SICK, CASUAL, ANNUAL, MATERNITY, OTHER
  startDate    DateTime
  endDate      DateTime
  reason       String
  status       String   @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedById String?
  approvedBy   User?    @relation("ApprovedLeaves", fields: [approvedById], references: [id], onDelete: SetNull)
  notes        String?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@map("leave_requests")
}

model ShiftRoster {
  id           String   @id @default(uuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String   // e.g. "Morning Shift", "Night Shift"
  startTime    String   // e.g. "09:00"
  endTime      String   // e.g. "17:00"
  gracePeriod  Int      @default(15) // grace period in minutes
  createdAt    DateTime @default(now())

  @@map("shift_rosters")
}

model PayrollPeriod {
  id           String   @id @default(uuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  month        Int      // 1 to 12
  year         Int
  basicSalary  Float
  allowances   Float    @default(0.0)
  deductions   Float    @default(0.0)
  netSalary    Float
  status       String   @default("PENDING") // PENDING, PROCESSING, DISBURSED
  paymentDate  DateTime?
  referenceNo  String?
  notes        String?
  createdAt    DateTime @default(now())

  @@unique([companyId, userId, month, year])
  @@index([userId])
  @@map("payroll_periods")
}

model CompanyExpense {
  id           String   @id @default(uuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  amount       Float
  description  String
  category     String   // e.g. "TRAVEL", "OFFICE", "MARKETING"
  date         DateTime @default(now())
  paidById     String?
  paidBy       User?    @relation(fields: [paidById], references: [id], onDelete: SetNull)
  chatGroupId  String?  // Reference if logged from chat room expense
  referenceNo  String?
  createdAt    DateTime @default(now())

  @@index([companyId])
  @@index([referenceNo])
  @@map("company_expenses")
}

model CompanyReceipt {
  id           String   @id @default(uuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  amount       Float
  payerName    String
  category     String   // e.g. "SALES_REVENUE", "ASSET_SALE", "OTHER_INCOME"
  date         DateTime @default(now())
  paymentMethod String  // BANK_TRANSFER, CASH, UPI, CREDIT_CARD
  referenceNo  String?
  notes        String?
  createdAt    DateTime @default(now())

  @@map("company_receipts")
}

model CashbookVoucher {
  id           String   @id @default(uuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  date         DateTime @default(now())
  voucherNo    String
  entryType    String   // INWARD_RECEIPT, OUTWARD_PAYMENT, OUTWARD_EXPENSE
  amount       Float
  previousBal  Float    @default(0.0)
  currentBal   Float    @default(0.0)
  description  String
  referenceNo  String?  // links to invoiceNo, expenseId, etc.
  createdAt    DateTime @default(now())

  @@unique([companyId, voucherNo])
  @@index([companyId])
  @@index([referenceNo])
  @@map("cashbook_vouchers")
}

model CompanyBankAccount {
  id           String   @id @default(uuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bankName     String   // e.g. "HDFC Bank", "ICICI Bank"
  accountNo    String
  branchName   String?
  ifscCode     String
  accountType  String   // SAVINGS, CURRENT, OVERDRAFT
  balance      Float    @default(0.0)
  createdAt    DateTime @default(now())

  @@unique([companyId, accountNo])
  @@map("company_bank_accounts")
}

// ==========================================
// MANUFACTURING MODULE EXPANSIONS
// ==========================================

model BillOfMaterials {
  id                   String           @id @default(uuid())
  companyId            String
  company              Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name                 String?
  description          String?
  finishedProductId    String
  finishedProduct      Product          @relation("FinishedProductBOM", fields: [finishedProductId], references: [id], onDelete: Cascade)
  version              String
  baseQuantity         Float            @default(1.0)
  validFrom            DateTime?
  validTo              DateTime?
  laborHours           Float            @default(0.0)
  laborRate            Float            @default(0.0)
  overheadAllocation   Float            @default(0.0)
  status               String           @default("ACTIVE") // ACTIVE, ARCHIVED, DRAFT
  components           BomComponent[]   @relation("ParentBom")
  usedAsSubBom         BomComponent[]   @relation("SubBom")
  productionPlans      ProductionPlan[]
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@unique([companyId, finishedProductId, version])
  @@map("bill_of_materials")
}

model BomComponent {
  id            String          @id @default(uuid())
  bomId         String
  bom           BillOfMaterials @relation("ParentBom", fields: [bomId], references: [id], onDelete: Cascade)
  productId     String
  product       Product         @relation("ComponentProductBOM", fields: [productId], references: [id], onDelete: Cascade)
  qtyRequired   Float
  wasteMargin   Float           @default(0.0)
  componentType String          @default("STOCK") // STOCK, NON_STOCK
  operationSeqNo Int?

  // Sub-BOM reference
  subBomId      String?
  subBom        BillOfMaterials? @relation("SubBom", fields: [subBomId], references: [id], onDelete: SetNull)

  @@map("bom_components")
}

model ProductionPlan {
  id                  String           @id @default(uuid())
  companyId           String
  company             Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  salesOrderId        String?
  salesOrder          SalesOrder?      @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  finishedProductId   String
  finishedProduct     Product          @relation(fields: [finishedProductId], references: [id], onDelete: Cascade)
  qtyToProduce        Float
  startDate           DateTime
  endDate             DateTime
  status              String           @default("PENDING") // PENDING, SCHEDULED, RELEASED, COMPLETED
  bomId               String
  bom                 BillOfMaterials  @relation(fields: [bomId], references: [id], onDelete: Cascade)
  workOrders          WorkOrder[]
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@map("production_plans")
}

model WorkOrder {
  id                  String           @id @default(uuid())
  companyId           String
  company             Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  woNo                String           @unique
  planId              String
  plan                ProductionPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  qtyTarget           Float
  qtyProduced         Float            @default(0.0)
  priority            String           @default("NORMAL") // URGENT, HIGH, NORMAL
  status              String           @default("RELEASED") // DRAFT, RELEASED, IN_PROGRESS, COMPLETED
  routingStage        String           @default("Scheduled Routing")
  jobCards            JobCard[]
  productionLogs      ProductionLog[]
  materialIssues      MaterialIssue[]
  subcontractPos      PurchaseOrder[]
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@map("work_orders")
}

model JobCard {
  id                String          @id @default(uuid())
  companyId         String
  company           Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  woId              String
  workOrder         WorkOrder       @relation(fields: [woId], references: [id], onDelete: Cascade)
  operationName     String
  workCenterId      String?
  workCenter        WorkCenter?     @relation(fields: [workCenterId], references: [id], onDelete: SetNull)
  assignedOperatorId String?
  assignedOperator   User?          @relation("AssignedOperator", fields: [assignedOperatorId], references: [id], onDelete: SetNull)
  status            String          @default("PENDING") // PENDING, RUNNING, COMPLETED, PAUSED
  startTime         DateTime?
  endTime           DateTime?
  cycleTimeMinutes  Float           @default(0.0)
  qtyTarget         Float
  qtyAccepted       Float           @default(0.0)
  qtyScrapped       Float           @default(0.0)
  subcontractPos    PurchaseOrder[]
  
  // Outsource fields
  operationType      String          @default("IN_HOUSE") // IN_HOUSE or OUTSOURCED
  vendorId           String?
  vendor             Vendor?         @relation("JobCardVendor", fields: [vendorId], references: [id], onDelete: SetNull)
  outsourceCost      Float           @default(0.0)

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@map("job_cards")
}

model ProductionLog {
  id                String          @id @default(uuid())
  companyId         String
  company           Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  woId              String
  workOrder         WorkOrder       @relation(fields: [woId], references: [id], onDelete: Cascade)
  qtyCompleted      Float
  qtyScrapped       Float           @default(0.0)
  operatorName      String
  consumptionStatus String          @default("CONSUMED") // CONSUMED, PENDING
  dateLog           DateTime        @default(now())
  createdAt         DateTime        @default(now())

  @@map("production_logs")
}

model QualityControlRecord {
  id              String          @id @default(uuid())
  companyId       String
  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  batchNo         String
  productId       String
  product         Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  totalInspected  Float
  qtyPassed       Float
  qtyFailed       Float           @default(0.0)
  inspectorName   String
  status          String          @default("PASSED") // PASSED, FAILED, REWORK_REQUIRED
  remarks         String?
  checkDate       DateTime        @default(now())
  reworkCards     ReworkCard[]
  createdAt       DateTime        @default(now())

  @@map("quality_control_records")
}

model ReworkCard {
  id                String               @id @default(uuid())
  companyId         String
  company           Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  qcRecordId        String
  qcRecord          QualityControlRecord @relation(fields: [qcRecordId], references: [id], onDelete: Cascade)
  batchNo           String
  productId         String
  product           Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  qtyToRepair       Float
  reworkOperation   String
  assignedOperatorId String?
  assignedOperator   User?               @relation("AssignedReworkOperator", fields: [assignedOperatorId], references: [id], onDelete: SetNull)
  status            String               @default("OPEN") // OPEN, REPAIRED_PASSED, SCRAPPED
  notes             String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@map("rework_cards")
}

model WorkCenter {
  id              String          @id @default(uuid())
  companyId       String
  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name            String
  code            String
  capacityHours   Float
  runtimeLogged   Float           @default(0.0)
  efficiencyScore Float           @default(100.0)
  electricityKw   Float           @default(0.0)
  status          String          @default("OPERATIONAL") // OPERATIONAL, MAINTENANCE, OFFLINE
  jobCards        JobCard[]
  factoryShifts   FactoryShift[]
  routingOperations RoutingOperation[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([companyId, code])
  @@map("work_centers")
}

model FactoryShift {
  id              String          @id @default(uuid())
  companyId       String
  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  operatorId      String
  operator        User            @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  workCenterId    String
  workCenter      WorkCenter      @relation(fields: [workCenterId], references: [id], onDelete: Cascade)
  shiftName       String
  shiftHours      String
  assignedMachine String
  dateScheduled   DateTime
  createdAt       DateTime        @default(now())

  @@map("factory_shifts")
}

model Routing {
  id              String             @id @default(uuid())
  companyId       String
  productId       String             @unique
  product         Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  name            String
  operations      RoutingOperation[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@map("routings")
}

model RoutingOperation {
  id              String      @id @default(uuid())
  routingId       String
  routing         Routing     @relation(fields: [routingId], references: [id], onDelete: Cascade)
  sequenceNo      Int         // e.g. 10, 20, 30
  operationName   String
  workCenterId    String?
  workCenter      WorkCenter? @relation(fields: [workCenterId], references: [id], onDelete: SetNull)
  setupTimeMins   Float       @default(0.0)
  runTimePerUnit  Float       @default(0.0)

  // Outsource/Subcontract fields
  operationType   String      @default("IN_HOUSE") // "IN_HOUSE" or "OUTSOURCED"
  vendorId        String?
  vendor          Vendor?     @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  outsourceCost   Float       @default(0.0)
  leadTimeDays    Int         @default(0)

  @@map("routing_operations")
}

model MaterialIssue {
  id            String      @id @default(uuid())
  companyId     String
  woId          String
  workOrder     WorkOrder   @relation(fields: [woId], references: [id], onDelete: Cascade)
  productId     String      // Raw material
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity      Float
  issuedDate    DateTime    @default(now())

  @@index([woId])
  @@map("material_issues")
}

model DocumentTemplate {
  id          String   @id @default(uuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  docType     String   // "INVOICE", "PROFORMA", "CHALLAN"
  name        String
  title       String   @default("Tax Invoice")
  isDefault   Boolean  @default(false)
  settings    String   // JSON stringified display toggles (logo, columns, bank, etc.)
  terms       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([companyId, docType, name])
  @@map("document_templates")
}

model ForecastConfigurations {
  id                            String   @id @default(uuid())
  tenantId                      String   @unique
  company                       Company  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  forecastEnabled               Boolean  @default(false)
  forecastMode                  String   @default("AUTOMATIC") // AUTOMATIC, MANUAL, DISABLED
  frequency                     String   @default("DAILY")     // DAILY, WEEKLY, MONTHLY, CUSTOM
  cronExpression                String?  // custom cron
  forecastTime                  String   @default("02:00")     // "HH:MM"
  historicalDataMonths          Int      @default(12)
  modelType                     String   @default("PROPHET")   // PROPHET, ARIMA, PROPHET_SEASONAL
  enableSeasonality             Boolean  @default(false)
  enablePurchaseRecommendations Boolean  @default(false)
  enableDeadStockAnalysis       Boolean  @default(false)
  enableSlowMovingAnalysis      Boolean  @default(false)
  forecastRetentionPeriodDays   Int      @default(90)
  lastRunAt                     DateTime?
  nextRunAt                     DateTime?
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  @@map("forecast_configurations")
}

model ForecastStatus {
  tenantId           String   @id
  company            Company  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  needsRefresh       Boolean  @default(false)
  lastForecastRun    DateTime?
  lastDataChange     DateTime?
  nextScheduledRun   DateTime?
  status             String   @default("PENDING") // Pending, Running, Completed, Failed

  @@map("forecast_status")
}

model ForecastHistory {
  id                String   @id @default(uuid())
  tenantId          String
  company           Company  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  forecastRunDate   DateTime @default(now())
  productsProcessed Int
  processingTime    Float    // elapsed seconds
  modelVersion      String
  forecastAccuracy  Float?
  createdAt         DateTime @default(now())

  @@index([tenantId])
  @@map("forecast_history")
}

model ForecastPrediction {
  id                  String   @id @default(uuid())
  tenantId            String
  company             Company  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId           String
  product             Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  predictedDemand     Float
  recommendedPurchase Float    @default(0.0)
  isDeadStock         Boolean  @default(false)
  isSlowMoving        Boolean  @default(false)
  seasonalityIndex    Float    @default(1.0)
  confidenceInterval  Float    @default(0.8)
  forecastDate        DateTime @default(now())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([tenantId])
  @@index([productId])
  @@map("forecast_predictions")
}

model ForecastJob {
  id         String   @id @default(uuid())
  tenantId   String
  company    Company  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  status     String   @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  error      String?
  runDate    DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tenantId])
  @@index([status])
  @@map("forecast_jobs")
}

model ExchangeRate {
  id         String   @id @default(uuid())
  baseCode   String   // e.g., "USD"
  targetCode String   // e.g., "INR"
  rate       Float
  updatedAt  DateTime @updatedAt

  @@unique([baseCode, targetCode])
  @@map("exchange_rates")
}


