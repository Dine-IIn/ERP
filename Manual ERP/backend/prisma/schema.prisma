datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Company {
  id               String           @id @default(uuid())
  companyCode      String           @unique
  name             String
  status           String           @default("ACTIVE")
  subscriptionTier String           @default("BASIC")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  users            User[]
  roles            Role[]
  features         CompanyFeature[]

  // --- EXTENSION: COMPANY PROFILE & SETTINGS ---
  legalCompanyName    String?
  companyLogo         String?
  fileSizeLimit       Int?    @default(50)
  backupAccess        Boolean @default(false)
  backupRetentionDays Int?    @default(60)
  autoBackupInterval  Int?    @default(2)
  companyEmail        String?
  companyPhone        String?
  alternatePhone      String?
  website             String?
  industryType        String?
  businessType        String?
  companyDescription  String?

  // SMTP Settings for Email Integration
  smtpHost     String?
  smtpPort     Int?
  smtpUser     String?
  smtpPassword String?
  smtpSecure   Boolean @default(false)
  smtpSender   String?

  // Tax Info
  gstin      String?
  pan        String?
  tan        String?
  vatNumber  String?
  cinNumber  String?
  msmeNumber String?

  // Address
  country      String?
  state        String?
  city         String?
  pincode      String?
  addressLine1 String?
  addressLine2 String?
  landmark     String?

  // Business Details
  fiscalYearStart  String?
  fiscalYearEnd    String?
  currencyId       String?
  timezone         String?
  dateFormat       String?
  language         String?
  decimalPrecision Int?    @default(2)

  // Branding
  primaryColor    String?
  secondaryColor  String?
  dashboardTheme  String? @default("dark")
  favicon         String?
  invoiceTemplate String? @default("STANDARD")

  // Relations
  auditLogs   AuditLog[]
  departments Department[]
  customers         Customer[]
  vendors           Vendor[]
  productCategories ProductCategory[]
  brands            Brand[]
  products          Product[]
  salesOrders       SalesOrder[]
  proformaInvoices  ProformaInvoice[]
  salesInvoices     SalesInvoice[]
  deliveryChallans  DeliveryChallan[]
  dispatches        Dispatch[]
  taxes             Tax[]
  leads             Lead[]
  opportunities     Opportunity[]
  followups         FollowUp[]
  quotations        Quotation[]
  serviceTickets    ServiceTicket[]
  vendorQuotations  VendorQuotation[]
  purchaseOrders    PurchaseOrder[]
  grns              Grn[]
  purchaseReturns   PurchaseReturn[]
  vendorPayments    VendorPayment[]
  stockAdjustments  StockAdjustment[]

  @@map("companies")
}

model Feature {
  id          String           @id @default(uuid())
  key         String           @unique
  name        String
  description String?
  companies   CompanyFeature[]

  @@map("features")
}

model CompanyFeature {
  companyId String
  featureId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  feature   Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@id([companyId, featureId])
  @@map("company_features")
}

model Role {
  id          String   @id @default(uuid())
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  permissions String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]

  @@unique([companyId, name])
  @@map("roles")
}

model User {
  id                String         @id @default(uuid())
  companyId         String
  company           Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  username          String
  passwordHash      String
  mobileNo          String         @unique
  email             String?
  status            String         @default("PENDING_APPROVAL")
  hasBackupAccess   Boolean        @default(false)
  roleId            String?
  role              Role?          @relation(fields: [roleId], references: [id], onDelete: SetNull)
  departmentId      String?
  department        Department?    @relation("DepartmentUsers", fields: [departmentId], references: [id], onDelete: SetNull)
  managedDepartment Department?    @relation("DepartmentManager")
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  pushTokens        PushToken[]
  notifications     Notification[]
  sessions          UserSession[]

  // Employee Master Extensions
  reportsToId       String?
  reportsTo         User?         @relation("UserHierarchy", fields: [reportsToId], references: [id])
  subordinates      User[]        @relation("UserHierarchy")
  shiftStart        String?
  shiftEnd          String?
  shiftName         String?
  documents         String?
  assignedLeads     Lead[]

  @@unique([companyId, username])
  @@map("users")
}

model UserSession {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceType   String   // "DESKTOP" or "MOBILE"
  deviceModel  String?  // e.g. "Chrome Browser", "Android Phone"
  token        String   @unique
  lastActiveAt DateTime @default(now())
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@map("user_sessions")
}

model OTPVerification {
  id        String   @id @default(uuid())
  target    String
  otpCode   String
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("otp_verifications")
}

model PushToken {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceToken String   @unique
  platform    String
  updatedAt   DateTime @updatedAt

  @@map("push_tokens")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  category  String
  channels  String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  description String?
  type        String?
  priority    String? @default("MEDIUM")
  module      String?
  redirectUrl String?
  companyId   String?
  isArchived  Boolean @default(false)

  @@map("notifications")
}

model ChatGroup {
  id          String   @id @default(uuid())
  companyId   String
  name        String
  type        String
  createdById String
  settings    String   @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("chat_groups")
}

model GroupMember {
  id        String   @id @default(uuid())
  groupId   String
  userId    String
  role      String   @default("MEMBER")
  createdAt DateTime @default(now())

  @@unique([groupId, userId])
  @@map("group_members")
}

model ChatMessage {
  id          String   @id @default(uuid())
  groupId     String
  senderId    String
  senderName  String
  message     String
  type        String   @default("TEXT")
  expenseData String?
  createdAt   DateTime @default(now())

  @@map("chat_messages")
}

model AuditLog {
  id         String   @id @default(uuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId     String?
  username   String?
  moduleName String
  actionType String
  oldValue   String?
  newValue   String?
  ipAddress  String?
  deviceInfo String?
  timestamp  DateTime @default(now())

  @@map("audit_logs")
}

model Department {
  id          String   @id @default(uuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  description String?
  features    String   @default("[]") // JSON stringified array of feature keys
  managerId   String?  @unique
  manager     User?    @relation("DepartmentManager", fields: [managerId], references: [id], onDelete: SetNull)
  users       User[]   @relation("DepartmentUsers")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([companyId, name])
  @@map("departments")
}

model Customer {
  id              String   @id @default(uuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name            String
  customerType    String   // "INDIVIDUAL" or "COMPANY"
  customerGroup   String?  // e.g. "RETAILER", "WHOLESALER"
  contactPerson   String?
  contactNo       String
  email           String?
  billingAddress  String?
  shippingAddress String?
  creditLimit     Float    @default(0.0)
  creditTime      Int      @default(0)
  clientClassification String?  @default("NATIONAL") // "NATIONAL" or "INTERNATIONAL"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  salesOrders     SalesOrder[]
  proformaInvoices ProformaInvoice[]
  salesInvoices   SalesInvoice[]
  deliveryChallans DeliveryChallan[]
  quotations      Quotation[]
  serviceTickets  ServiceTicket[]

  @@unique([companyId, name])
  @@map("customers")
}

model Vendor {
  id           String   @id @default(uuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String
  isVendor     Boolean  @default(true) // true = Vendor, false = Supplier
  contactNo    String
  email        String?
  bankDetails  String?
  paymentTerms String?
  gstDetails   String?
  creditTime   Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  vendorQuotations VendorQuotation[]
  purchaseOrders   PurchaseOrder[]
  vendorPayments   VendorPayment[]

  @@unique([companyId, name])
  @@map("vendors")
}

model ProductCategory {
  id        String    @id @default(uuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  products  Product[]
  createdAt DateTime  @default(now())

  @@unique([companyId, name])
  @@map("product_categories")
}

model Brand {
  id        String    @id @default(uuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  products  Product[]
  createdAt DateTime  @default(now())

  @@unique([companyId, name])
  @@map("brands")
}

model Product {
  id           String           @id @default(uuid())
  companyId    String
  company      Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String
  categoryId   String?
  category     ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brandId      String?
  brand        Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  uom          String
  pricing      Float            @default(0.0)
  hsnSacCode   String?
  imageUrl     String?
  bomReference String?
  moq          Float            @default(1.0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  variants     ProductVariant[]
  salesOrderItems      SalesOrderItem[]
  proformaInvoiceItems ProformaInvoiceItem[]
  salesInvoiceItems    SalesInvoiceItem[]
  deliveryChallanItems DeliveryChallanItem[]

  // --- INVENTORY MANAGEMENT ADDITIONS ---
  stock        Float            @default(0.0)   // Active physical stock level
  reorderLevel Float            @default(5.0)   // Alert threshold for low stock
  warehouseLoc String?          // Warehouse rack designation, e.g. "Rack A-3"
  quotationItems       QuotationItem[]
  serviceTickets       ServiceTicket[]
  vendorQuotationItems VendorQuotationItem[]
  purchaseOrderItems   PurchaseOrderItem[]
  grnItems             GrnItem[]
  purchaseReturnItems  PurchaseReturnItem[]
  stockAdjustments     StockAdjustment[]

  @@unique([companyId, name])
  @@map("products")
}

model ProductVariant {
  id         String   @id @default(uuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name       String
  sku        String?  @unique
  priceAddon Float    @default(0.0)
  createdAt  DateTime @default(now())

  @@map("product_variants")
}

model SalesOrder {
  id           String           @id @default(uuid())
  companyId    String
  company      Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId   String
  customer     Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderNo      String
  orderDate    DateTime         @default(now())
  deliveryDate DateTime?
  discount     Float            @default(0.0)
  status       String           @default("PENDING") // PENDING, DISPATCHED, COMPLETED, CANCELLED
  items        SalesOrderItem[]
  dispatches   Dispatch[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([companyId, orderNo])
  @@map("sales_orders")
}

model SalesOrderItem {
  id           String     @id @default(uuid())
  orderId      String
  order        SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity     Float
  price        Float
  deliveryDate DateTime?
  discount     Float      @default(0.0)

  @@map("sales_order_items")
}

model ProformaInvoice {
  id         String               @id @default(uuid())
  companyId  String
  company    Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  invoiceNo  String
  date       DateTime             @default(now())
  dueDate    DateTime?
  subtotal   Float
  discount   Float                @default(0.0)
  tax        Float                @default(0.0)
  total      Float
  status     String               @default("DRAFT") // DRAFT, SENT, PAID, CANCELLED
  items      ProformaInvoiceItem[]
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@unique([companyId, invoiceNo])
  @@map("proforma_invoices")
}

model ProformaInvoiceItem {
  id         String          @id @default(uuid())
  invoiceId  String
  invoice    ProformaInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId  String
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity   Float
  price      Float
  discount   Float           @default(0.0)

  @@map("proforma_invoice_items")
}

model SalesInvoice {
  id         String             @id @default(uuid())
  companyId  String
  company    Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  invoiceNo  String
  date       DateTime           @default(now())
  dueDate    DateTime?
  subtotal   Float
  discount   Float              @default(0.0)
  tax        Float              @default(0.0)
  total      Float
  status     String             @default("UNPAID") // UNPAID, PARTIAL, PAID, OVERDUE, CANCELLED
  items      SalesInvoiceItem[]
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@unique([companyId, invoiceNo])
  @@map("sales_invoices")
}

model SalesInvoiceItem {
  id        String       @id @default(uuid())
  invoiceId String
  invoice   SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId String
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Float
  price     Float
  discount  Float        @default(0.0)

  @@map("sales_invoice_items")
}

model DeliveryChallan {
  id         String                 @id @default(uuid())
  companyId  String
  company    Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  challanNo  String
  date       DateTime               @default(now())
  status     String                 @default("ISSUED") // ISSUED, RECEIVED, RETURNED, CANCELLED
  items      DeliveryChallanItem[]
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  @@unique([companyId, challanNo])
  @@map("delivery_challans")
}

model DeliveryChallanItem {
  id        String          @id @default(uuid())
  challanId String
  challan   DeliveryChallan @relation(fields: [challanId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Float
  price     Float           @default(0.0)

  @@map("delivery_challan_items")
}

model Dispatch {
  id             String      @id @default(uuid())
  companyId      String
  company        Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orderId        String
  order          SalesOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  dispatchNo     String
  dispatchDate   DateTime    @default(now())
  carrier        String?
  trackingNo     String?
  vehicleNo      String?
  shippingCost   Float       @default(0.0)
  status         String      @default("SHIPPED") // SHIPPED, IN_TRANSIT, DELIVERED, RETURNED
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([companyId, dispatchNo])
  @@map("dispatches")
}

// ==========================================
// NEW ERP EXPANSION MODELS
// ==========================================

model Tax {
  id         String   @id @default(uuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name       String   // e.g. "GST 18%", "VAT 5%"
  rate       Float    // e.g. 18.0, 5.0
  type       String   // "GST", "VAT", "SALES_TAX", "SERVICE_TAX"
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([companyId, name])
  @@map("taxes")
}

model Lead {
  id             String   @id @default(uuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name           String   // Contact name
  companyName    String?  // Associated company
  email          String?
  phone          String
  source         String   // "WEBSITE", "REFERRAL", "COLD_CALL", "EXHIBITION", "OTHER"
  status         String   // "NEW", "CONTACTED", "QUALIFIED", "LOST"
  assignedToId   String?
  assignedTo     User?    @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  opportunities  Opportunity[]
  followups      FollowUp[]

  @@map("leads")
}

model Opportunity {
  id             String   @id @default(uuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  leadId         String
  lead           Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  title          String   // e.g. "100 Tons Copper Wire Supply"
  value          Float    // Estimated deal value
  stage          String   // "PROSPECTING", "PROPOSAL", "NEGOTIATION", "WON", "LOST"
  probability    Float    // Conversion percentage probability (e.g. 20, 50, 90)
  closeDate      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("opportunities")
}

model FollowUp {
  id             String   @id @default(uuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  leadId         String
  lead           Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  scheduledDate  DateTime
  type           String   // "CALL", "EMAIL", "MEETING", "DEMO"
  status         String   // "PENDING", "COMPLETED", "CANCELLED"
  notes          String?
  outcome        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("followups")
}

model Quotation {
  id           String          @id @default(uuid())
  companyId    String
  company      Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId   String
  customer     Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  quoteNo      String
  date         DateTime        @default(now())
  expiryDate   DateTime?
  subtotal     Float
  discount     Float           @default(0.0) // percentage
  tax          Float           @default(0.0)
  total        Float
  status       String          @default("DRAFT") // DRAFT, SENT, ACCEPTED, REJECTED, EXPIRED
  items        QuotationItem[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([companyId, quoteNo])
  @@map("quotations")
}

model QuotationItem {
  id          String    @id @default(uuid())
  quoteId     String
  quotation   Quotation @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity    Float
  price       Float
  discount    Float     @default(0.0)

  @@map("quotation_items")
}

model ServiceTicket {
  id             String   @id @default(uuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  serialNumber   String?
  ticketNo       String
  title          String   // ticket summary
  type           String   // "MAINTENANCE", "REPAIR", "INSTALLATION", "WARRANTY_CLAIM"
  priority       String   // "LOW", "MEDIUM", "HIGH", "CRITICAL"
  status         String   // "OPEN", "IN_PROGRESS", "RESOLVED", "CLOSED"
  scheduledDate  DateTime?
  resolutionNotes String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([companyId, ticketNo])
  @@map("service_tickets")
}

model VendorQuotation {
  id             String                 @id @default(uuid())
  companyId      String
  company        Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vendorId       String
  vendor         Vendor                 @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  quoteNo        String
  date           DateTime               @default(now())
  validUntil     DateTime?
  subtotal       Float
  tax            Float                  @default(0.0)
  total          Float
  status         String                 @default("PENDING") // PENDING, ACCEPTED, REJECTED
  items          VendorQuotationItem[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@unique([companyId, quoteNo])
  @@map("vendor_quotations")
}

model VendorQuotationItem {
  id          String          @id @default(uuid())
  quoteId     String
  quotation   VendorQuotation @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId   String
  product     Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity    Float
  price       Float

  @@map("vendor_quotation_items")
}

model PurchaseOrder {
  id           String              @id @default(uuid())
  companyId    String
  company      Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vendorId     String
  vendor       Vendor              @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  poNo         String
  date         DateTime            @default(now())
  deliveryDate DateTime?
  subtotal     Float
  discount     Float               @default(0.0) // percentage
  tax          Float               @default(0.0)
  total        Float
  status       String              @default("PENDING") // PENDING, APPROVED, SHIPPED, COMPLETED
  items        PurchaseOrderItem[]
  grns         Grn[]
  returns      PurchaseReturn[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([companyId, poNo])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id          String        @id @default(uuid())
  poId        String
  po          PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  productId   String
  product     Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity    Float
  price       Float
  discount    Float         @default(0.0)

  @@map("purchase_order_items")
}

model Grn {
  id             String     @id @default(uuid())
  companyId      String
  company        Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  poId           String
  purchaseOrder  PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  grnNo          String
  receivedDate   DateTime   @default(now())
  receivedBy     String?
  gateEntryNo    String?
  challanNo      String?
  status         String     @default("RECEIVED") // RECEIVED, INSPECTED, REJECTED
  notes          String?
  items          GrnItem[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([companyId, grnNo])
  @@map("grns")
}

model GrnItem {
  id          String   @id @default(uuid())
  grnId       String
  grn         Grn      @relation(fields: [grnId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  qtyOrdered  Float
  qtyReceived Float
  qtyAccepted Float
  qtyRejected Float    @default(0.0)

  @@map("grn_items")
}

model PurchaseReturn {
  id             String               @id @default(uuid())
  companyId      String
  company        Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  poId           String
  purchaseOrder  PurchaseOrder        @relation(fields: [poId], references: [id], onDelete: Cascade)
  returnNo       String
  returnDate     DateTime             @default(now())
  reason         String
  status         String               @default("PENDING") // PENDING, SENT, COMPLETED
  items          PurchaseReturnItem[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([companyId, returnNo])
  @@map("purchase_returns")
}

model PurchaseReturnItem {
  id          String         @id @default(uuid())
  returnId    String
  pret        PurchaseReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  productId   String
  product     Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity    Float
  price       Float

  @@map("purchase_return_items")
}

model VendorPayment {
  id             String   @id @default(uuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vendorId       String
  vendor         Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  paymentNo      String
  paymentDate    DateTime @default(now())
  amount         Float
  paymentMethod  String   // "BANK_TRANSFER", "CASH", "CHEQUE", "UPI", "CREDIT_CARD"
  referenceNo    String?  // Bank transfer / UPI reference
  bankDetails    String?
  status         String   @default("COMPLETED") // PENDING, COMPLETED, FAILED
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([companyId, paymentNo])
  @@map("vendor_payments")
}

model StockAdjustment {
  id             String   @id @default(uuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  adjustmentNo   String
  date           DateTime @default(now())
  type           String   // "INWARD_PO", "OUTWARD_SO", "INWARD_RETURN", "OUTWARD_RETURN", "MANUAL_ADD", "MANUAL_SUB"
  quantity       Float    // Positive/Negative
  previousStock  Float
  newStock       Float
  reason         String?
  referenceNo    String?
  createdAt      DateTime @default(now())

  @@unique([companyId, adjustmentNo])
  @@map("stock_adjustments")
}
