datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Company {
  id               String           @id @default(uuid())
  companyCode      String           @unique
  name             String
  status           String           @default("ACTIVE")
  subscriptionTier String           @default("BASIC")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  users            User[]
  roles            Role[]
  features         CompanyFeature[]

  // --- EXTENSION: COMPANY PROFILE & SETTINGS ---
  legalCompanyName    String?
  companyLogo         String?
  fileSizeLimit       Int?    @default(50)
  backupAccess        Boolean @default(false)
  backupRetentionDays Int?    @default(60)
  companyEmail        String?
  companyPhone        String?
  alternatePhone      String?
  website             String?
  industryType        String?
  businessType        String?
  companyDescription  String?

  // SMTP Settings for Email Integration
  smtpHost     String?
  smtpPort     Int?
  smtpUser     String?
  smtpPassword String?
  smtpSecure   Boolean @default(false)
  smtpSender   String?

  // Tax Info
  gstin      String?
  pan        String?
  tan        String?
  vatNumber  String?
  cinNumber  String?
  msmeNumber String?

  // Address
  country      String?
  state        String?
  city         String?
  pincode      String?
  addressLine1 String?
  addressLine2 String?
  landmark     String?

  // Business Details
  fiscalYearStart  String?
  fiscalYearEnd    String?
  currencyId       String?
  timezone         String?
  dateFormat       String?
  language         String?
  decimalPrecision Int?    @default(2)

  // Branding
  primaryColor    String?
  secondaryColor  String?
  dashboardTheme  String? @default("dark")
  favicon         String?
  invoiceTemplate String? @default("STANDARD")

  // Relations
  auditLogs AuditLog[]

  @@map("companies")
}

model Feature {
  id          String           @id @default(uuid())
  key         String           @unique
  name        String
  description String?
  companies   CompanyFeature[]

  @@map("features")
}

model CompanyFeature {
  companyId String
  featureId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  feature   Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@id([companyId, featureId])
  @@map("company_features")
}

model Role {
  id          String   @id @default(uuid())
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  permissions String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]

  @@unique([companyId, name])
  @@map("roles")
}

model User {
  id              String         @id @default(uuid())
  companyId       String
  company         Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  username        String
  passwordHash    String
  mobileNo        String         @unique
  email           String?
  status          String         @default("PENDING_APPROVAL")
  hasBackupAccess Boolean        @default(false)
  roleId          String?
  role            Role?          @relation(fields: [roleId], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  pushTokens      PushToken[]
  notifications   Notification[]
  sessions        UserSession[]

  @@unique([companyId, username])
  @@map("users")
}

model UserSession {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceType   String   // "DESKTOP" or "MOBILE"
  deviceModel  String?  // e.g. "Chrome Browser", "Android Phone"
  token        String   @unique
  lastActiveAt DateTime @default(now())
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@map("user_sessions")
}

model OTPVerification {
  id        String   @id @default(uuid())
  target    String
  otpCode   String
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("otp_verifications")
}

model PushToken {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceToken String   @unique
  platform    String
  updatedAt   DateTime @updatedAt

  @@map("push_tokens")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  category  String
  channels  String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  description String?
  type        String?
  priority    String? @default("MEDIUM")
  module      String?
  redirectUrl String?
  companyId   String?
  isArchived  Boolean @default(false)

  @@map("notifications")
}

model ChatGroup {
  id          String   @id @default(uuid())
  companyId   String
  name        String
  type        String
  createdById String
  settings    String   @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("chat_groups")
}

model GroupMember {
  id        String   @id @default(uuid())
  groupId   String
  userId    String
  role      String   @default("MEMBER")
  createdAt DateTime @default(now())

  @@unique([groupId, userId])
  @@map("group_members")
}

model ChatMessage {
  id          String   @id @default(uuid())
  groupId     String
  senderId    String
  senderName  String
  message     String
  type        String   @default("TEXT")
  expenseData String?
  createdAt   DateTime @default(now())

  @@map("chat_messages")
}

model AuditLog {
  id         String   @id @default(uuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId     String?
  username   String?
  moduleName String
  actionType String
  oldValue   String?
  newValue   String?
  ipAddress  String?
  deviceInfo String?
  timestamp  DateTime @default(now())

  @@map("audit_logs")
}
