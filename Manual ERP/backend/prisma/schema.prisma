datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Enforced via application level validation: "PENDING" | "ACTIVE" | "SUSPENDED"
model Company {
  id               String           @id @default(uuid())
  companyCode      String           @unique
  name             String
  status           String           @default("ACTIVE")
  subscriptionTier String           @default("BASIC") // "BASIC" | "PREMIUM" | "ENTERPRISE"
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  users            User[]
  roles            Role[]
  features         CompanyFeature[]

  // --- EXTENSION: COMPANY PROFILE & SETTINGS ---
  legalCompanyName   String?
  companyLogo        String?
  fileSizeLimit        Int?    @default(50) // MB default per company
  backupAccess         Boolean @default(false) // admin can give backup access
  backupRetentionDays  Int?    @default(60) // days
  companyEmail       String?
  companyPhone       String?
  alternatePhone     String?
  website            String?
  industryType       String?
  businessType       String?
  companyDescription String?

  // SMTP Settings for Email Integration
  smtpHost           String?
  smtpPort           Int?
  smtpUser           String?
  smtpPassword       String?
  smtpSecure         Boolean @default(false)
  smtpSender         String?


  // Tax Info
  gstin              String?
  pan                String?
  tan                String?
  vatNumber          String?
  cinNumber          String?
  msmeNumber         String?

  // Address
  country            String?
  state              String?
  city               String?
  pincode            String?
  addressLine1       String?
  addressLine2       String?
  landmark           String?

  // Business Details
  fiscalYearStart    String?
  fiscalYearEnd      String?
  currencyId         String?
  timezone           String?
  dateFormat         String?
  language           String?
  decimalPrecision   Int?             @default(2)

  // Branding
  primaryColor       String?
  secondaryColor     String?
  dashboardTheme     String?          @default("dark")
  favicon            String?
  invoiceTemplate    String?          @default("STANDARD")

  // Core Module Relations
  taxSettings        TaxSetting[]
  currencies         Currency[]
  auditLogs          AuditLog[]
  workflows          ApprovalWorkflow[]
  approvalRequests   ApprovalRequest[]
  documents          Document[]
  dashboardLayouts   DashboardLayout[]
  backupLogs         BackupLog[]
  departments        Department[]

  // Master Data Relations
  productMasters     ProductMaster[]
  customerMasters    CustomerMaster[]
  vendorMasters      VendorMaster[]
  employeeMasters    EmployeeMaster[]
  warehouseMasters   WarehouseMaster[]
  taxMasters         TaxMaster[]
  unitMasters        UnitMaster[]
  categoryMasters    CategoryMaster[]
  brandMasters       BrandMaster[]
  chartOfAccounts    ChartOfAccounts[]

  // Finance Module Relations
  fiscalYears        FiscalYear[]
  journalEntries     JournalEntry[]
  assetMasters       AssetMaster[]
  bankAccounts       BankAccount[]
  budgets            Budget[]

  @@map("companies")
}

model Feature {
  id          String           @id @default(uuid())
  key         String           @unique // e.g., "CRM", "HR", "FINANCE", "NOTIFICATIONS"
  name        String
  description String?
  companies   CompanyFeature[]

  @@map("features")
}

model CompanyFeature {
  companyId String
  featureId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  feature   Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@id([companyId, featureId])
  @@map("company_features")
}

model Role {
  id          String   @id @default(uuid())
  companyId   String?  // Nullable for system-wide global roles
  company     Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  permissions String   // JSON stringified permissions mapping, e.g. '{"CRM": ["read", "write"]}'
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]

  @@unique([companyId, name])
  @@map("roles")
}

// Status enforced via validation: "PENDING_APPROVAL" | "ACTIVE" | "SUSPENDED"
model User {
  id               String            @id @default(uuid())
  companyId        String
  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  username         String
  passwordHash     String
  mobileNo         String            @unique
  email            String?
  status           String            @default("PENDING_APPROVAL")
  hasBackupAccess  Boolean           @default(false)
  roleId           String?
  role             Role?             @relation(fields: [roleId], references: [id], onDelete: SetNull)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  pushTokens       PushToken[]
  notifications    Notification[]
  approvalComments ApprovalComment[]
  approvalRequests ApprovalRequest[]
  uploadedDocs     Document[]
  dashboardLayouts DashboardLayout[]

  @@unique([companyId, username])
  @@map("users")
}

model OTPVerification {
  id        String   @id @default(uuid())
  mobileNo  String
  otpCode   String
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("otp_verifications")
}

model PushToken {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceToken String   @unique
  platform    String   // "ios" | "android" | "web" | "desktop"
  updatedAt   DateTime @updatedAt

  @@map("push_tokens")
}

model Notification {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  message     String
  category    String   // "system" | "CRM" | "hr" | "finance"
  channels    String   // comma-separated e.g. "in_app,push"
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  // --- EXTENSION: NOTIFICATION CENTER ---
  description String?
  type        String?  // "APPROVAL" | "INVOICE" | "STOCK" | "LOGIN" | "PAYMENT" | "EMPLOYEE" | "MAINTENANCE"
  priority    String?  @default("MEDIUM") // "LOW" | "MEDIUM" | "HIGH"
  module      String?
  redirectUrl String?
  companyId   String?
  isArchived  Boolean  @default(false)

  @@map("notifications")
}

model ChatGroup {
  id          String   @id @default(uuid())
  companyId   String
  name        String
  type        String   // "GENERAL" | "EXPENSE" | "DIRECT"
  createdById String
  settings    String   @default("{}") // JSON stringified settings
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("chat_groups")
}

model GroupMember {
  id        String   @id @default(uuid())
  groupId   String
  userId    String
  role      String   @default("MEMBER") // "ADMIN" | "MEMBER"
  createdAt DateTime @default(now())

  @@unique([groupId, userId])
  @@map("group_members")
}

model ChatMessage {
  id          String   @id @default(uuid())
  groupId     String
  senderId    String
  senderName  String
  message     String
  type        String   @default("TEXT") // "TEXT" | "EXPENSE" | "TRANSFER"
  expenseData String?  // JSON stringified expense/transfer logs
  createdAt   DateTime @default(now())

  @@map("chat_messages")
}

// --- EXTENSION: TAX CONFIGURATION ---
model TaxSetting {
  id              String   @id @default(uuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  taxName         String
  taxCode         String
  taxPercentage   Float
  taxType         String   // "GST" | "CGST" | "SGST" | "IGST" | "VAT" | "TDS"
  effectiveDate   DateTime
  taxStatus       String   @default("ACTIVE") // "ACTIVE" | "INACTIVE"
  hsnSacCode      String?
  category        String?
  isReverseCharge Boolean  @default(false)
  description     String?
  createdAt       DateTime @default(now())

  @@map("tax_settings")
}

// --- EXTENSION: CURRENCY MANAGEMENT ---
model Currency {
  id           String   @id @default(uuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  currencyCode String
  currencyName String
  symbol       String
  decimalPlaces Int      @default(2)
  exchangeRate Float    @default(1.0)
  activeStatus String   @default("ACTIVE") // "ACTIVE" | "INACTIVE"
  isBase       Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@unique([companyId, currencyCode])
  @@map("currencies")
}

// --- EXTENSION: AUDIT LOG SYSTEM ---
model AuditLog {
  id          String   @id @default(uuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId      String?
  username    String?
  moduleName  String   // "auth" | "company" | "tax" | "currency" | "approvals" | "documents" | "backup" | "chats"
  actionType  String   // "CREATE" | "READ" | "UPDATE" | "DELETE" | "LOGIN" | "LOGOUT" | "FAILED_LOGIN" | "APPROVAL" | "PERMISSION_CHANGE"
  oldValue    String?  // JSON string
  newValue    String?  // JSON string
  ipAddress   String?
  deviceInfo  String?
  timestamp   DateTime @default(now())

  @@map("audit_logs")
}

// --- EXTENSION: APPROVAL WORKFLOW ENGINE ---
model ApprovalWorkflow {
  id             String            @id @default(uuid())
  companyId      String
  company        Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workflowName   String
  module         String            // "purchase" | "expenses" | "sales" | "HR" | "finance"
  conditions     String?           // JSON description of conditions
  minAmount      Float?
  maxAmount      Float?
  autoApprove    Boolean           @default(false)
  escalationTime Int?              // in hours
  isActive       Boolean           @default(true)
  steps          ApprovalStep[]
  requests       ApprovalRequest[]
  createdAt      DateTime          @default(now())

  @@map("approval_workflows")
}

model ApprovalStep {
  id            String           @id @default(uuid())
  workflowId    String
  workflow      ApprovalWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  approverRole  String?          // e.g. "Manager" or "Director"
  approverRoleId String?
  approverUserId String?
  stepOrder     Int              @default(1)

  @@map("approval_steps")
}

model ApprovalRequest {
  id               String            @id @default(uuid())
  companyId        String
  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workflowId       String
  workflow         ApprovalWorkflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  requesterId      String
  requester        User              @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  requesterName    String
  module           String            // "purchase" | "expenses" | "sales" | "HR" | "finance"
  entityId         String            // References the specific record in chat or elsewhere
  amount           Float?
  status           String            @default("PENDING") // "PENDING" | "APPROVED" | "REJECTED" | "ESCALATED"
  currentStepOrder Int               @default(1)
  comments         ApprovalComment[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@map("approval_requests")
}

model ApprovalComment {
  id          String          @id @default(uuid())
  requestId   String
  request     ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  username    String
  comment     String
  action      String          // "COMMENT" | "APPROVE" | "REJECT" | "ESCALATE"
  createdAt   DateTime        @default(now())

  @@map("approval_comments")
}

// --- EXTENSION: DOCUMENT MANAGEMENT SYSTEM ---
model Document {
  id             String            @id @default(uuid())
  companyId      String
  company        Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  documentName   String
  filePath       String
  fileType       String            // "PDF" | "EXCEL" | "IMAGE" | "WORD"
  fileSize       Int
  uploadedById   String
  uploadedBy     User              @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  uploadedByName String
  module         String?           // e.g. "purchase" | "expenses" | "general"
  relatedEntityId String?
  isPublic       Boolean           @default(false)
  versions       DocumentVersion[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@map("documents")
}

model DocumentVersion {
  id             String   @id @default(uuid())
  documentId     String
  document       Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version        Int      @default(1)
  filePath       String
  fileSize       Int
  uploadedById   String
  uploadedByName String
  description    String?
  createdAt      DateTime @default(now())

  @@map("document_versions")
}

// --- EXTENSION: BACKUP & RESTORE ---
model BackupLog {
  id            String   @id @default(uuid())
  companyId     String?  // Nullable for system-wide backups
  company       Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  backupName    String
  backupType    String   // "MANUAL" | "SCHEDULED"
  fileSize      Int
  createdById   String
  createdByName String
  restoreStatus String   @default("PENDING") // "SUCCESS" | "FAILED" | "PENDING"
  filePath      String
  createdAt     DateTime @default(now())

  @@map("backup_logs")
}

// --- EXTENSION: DASHBOARD LAYOUTS ---
model DashboardLayout {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  layoutSettings String   // JSON string of widget layout states
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, companyId])
  @@map("dashboard_layouts")
}

// --- EXTENSION: MASTER DATA MANAGEMENT ---

model ProductMaster {
  id              String   @id @default(uuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productCode     String
  sku             String?
  barcode         String?
  productName     String
  category        String?
  categoryId      String?
  subcategory     String?
  brand           String?
  unit            String?
  unitId          String?
  hsnCode         String?
  taxCategory     String?
  costPrice       Float    @default(0.0)
  sellingPrice    Float    @default(0.0)
  reorderLevel    Float?   @default(0.0)
  minStock        Float?   @default(0.0)
  maxStock        Float?   @default(0.0)
  serialTracking  Boolean  @default(false)
  batchTracking   Boolean  @default(false)
  expiryTracking  Boolean  @default(false)
  dimensions      String?
  weight          Float?
  status          String   @default("ACTIVE") // "ACTIVE" | "INACTIVE" | "DRAFT"
  isDeleted       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([companyId, productCode])
  @@map("product_masters")
}

model CustomerMaster {
  id                String   @id @default(uuid())
  companyId         String
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerCode      String
  customerName      String
  companyName       String?
  gstin             String?
  pan               String?
  phone             String?
  email             String?
  billingAddress    String?
  shippingAddress   String?
  paymentTerms      String?
  creditLimit       Float    @default(0.0)
  outstandingAmount Float    @default(0.0)
  customerType      String?  // "INDIVIDUAL" | "COMMERCIAL"
  status            String   @default("ACTIVE") // "ACTIVE" | "INACTIVE"
  isDeleted         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  journalLines      JournalEntryLine[]

  @@unique([companyId, customerCode])
  @@map("customer_masters")
}

model VendorMaster {
  id             String   @id @default(uuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vendorCode     String
  vendorName     String
  gstin          String?
  contactPerson  String?
  paymentTerms   String?
  bankDetails    String?
  vendorCategory String?
  rating         Float?   @default(5.0)
  status         String   @default("ACTIVE")
  isDeleted      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  journalLines   JournalEntryLine[]

  @@unique([companyId, vendorCode])
  @@map("vendor_masters")
}

model EmployeeMaster {
  id            String    @id @default(uuid())
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeCode  String
  employeeName  String
  email         String?
  phone         String?
  department    String?
  designation   String?
  dateOfJoining DateTime?
  salary        Float?    @default(0.0)
  status        String    @default("ACTIVE")
  isDeleted     Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Structured Relations for Enterprise Org Hierarchy
  departmentId  String?
  departmentRef Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  
  managerId     String?
  manager       EmployeeMaster?  @relation("EmployeeHierarchy", fields: [managerId], references: [id], onDelete: SetNull)
  subordinates  EmployeeMaster[] @relation("EmployeeHierarchy")

  @@unique([companyId, employeeCode])
  @@map("employee_masters")
}

model WarehouseMaster {
  id            String   @id @default(uuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  warehouseCode String
  warehouseName String
  location      String?
  capacity      Float?
  status        String   @default("ACTIVE")
  isDeleted     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([companyId, warehouseCode])
  @@map("warehouse_masters")
}

model TaxMaster {
  id          String   @id @default(uuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  taxCode     String
  taxName     String
  taxRate     Float    @default(0.0)
  taxType     String   // "GST" | "VAT" | "TDS"
  status      String   @default("ACTIVE")
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([companyId, taxCode])
  @@map("tax_masters")
}

model UnitMaster {
  id          String   @id @default(uuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  unitCode    String
  unitName    String
  status      String   @default("ACTIVE")
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([companyId, unitCode])
  @@map("unit_masters")
}

model CategoryMaster {
  id               String   @id @default(uuid())
  companyId        String
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  categoryCode     String
  categoryName     String
  parentCategoryId String?
  status           String   @default("ACTIVE")
  isDeleted        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([companyId, categoryCode])
  @@map("category_masters")
}

model ChartOfAccounts {
  id              String   @id @default(uuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  accountCode     String
  accountName     String
  accountType     String   // "ASSET" | "LIABILITY" | "EQUITY" | "REVENUE" | "EXPENSE"
  parentAccountId String?
  balance         Float    @default(0.0)
  status          String   @default("ACTIVE")
  isDeleted       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  journalLines    JournalEntryLine[]
  budgets         Budget[]
  bankAccounts    BankAccount[]

  @@unique([companyId, accountCode])
  @@map("chart_of_accounts")
}

model Department {
  id                 String           @id @default(uuid())
  companyId          String
  company            Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  departmentCode     String
  departmentName     String
  managerId          String?          // references EmployeeMaster
  parentDepartmentId String?          // self-referencing for hierarchical departments
  isDeleted          Boolean          @default(false)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  employees          EmployeeMaster[]

  @@unique([companyId, departmentCode])
  @@map("departments")
}

model BrandMaster {
  id          String   @id @default(uuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  brandCode   String
  brandName   String
  status      String   @default("ACTIVE") // "ACTIVE" | "INACTIVE"
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([companyId, brandCode])
  @@map("brand_masters")
}

model FiscalYear {
  id             String         @id @default(uuid())
  companyId      String
  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  yearName       String         // e.g. "FY2026"
  startDate      DateTime
  endDate        DateTime
  status         String         @default("ACTIVE") // "ACTIVE" | "CLOSED"
  journalEntries JournalEntry[]
  budgets        Budget[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([companyId, yearName])
  @@map("fiscal_years")
}

model JournalEntry {
  id             String             @id @default(uuid())
  companyId      String
  company        Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fiscalYearId   String
  fiscalYear     FiscalYear         @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)
  entryNumber    String             // e.g. "JV-2026-0001"
  entryDate      DateTime
  postingDate    DateTime
  reference      String?
  narration      String
  status         String             @default("POSTED") // "DRAFT" | "POSTED" | "VOID"
  lines          JournalEntryLine[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([companyId, entryNumber])
  @@map("journal_entries")
}

model JournalEntryLine {
  id             String          @id @default(uuid())
  journalEntryId String
  journalEntry   JournalEntry    @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      String
  account        ChartOfAccounts @relation(fields: [accountId], references: [id], onDelete: Cascade)
  debit          Float           @default(0.0)
  credit         Float           @default(0.0)
  narration      String?
  
  customerId     String?
  customer       CustomerMaster? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  vendorId       String?
  vendor         VendorMaster?   @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@map("journal_entry_lines")
}

model AssetMaster {
  id                     String                     @id @default(uuid())
  companyId              String
  company                Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assetCode              String
  assetName              String
  purchaseDate           DateTime
  purchaseCost           Float
  depreciationMethod     String                     // "STRAIGHT_LINE" | "WRITTEN_DOWN_VALUE"
  usefulLifeYears        Int
  salvageValue           Float                      @default(0.0)
  accumulatedDepreciation Float                      @default(0.0)
  bookValue              Float
  status                 String                     @default("ACTIVE") // "ACTIVE" | "DISPOSED"
  depreciations          AssetDepreciationSchedule[]
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt

  @@unique([companyId, assetCode])
  @@map("asset_masters")
}

model AssetDepreciationSchedule {
  id                 String       @id @default(uuid())
  assetId            String
  asset              AssetMaster  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  depreciationDate   DateTime
  depreciationAmount Float
  bookValueAfter     Float
  isPosted           Boolean      @default(false)
  journalEntryId     String?
  createdAt          DateTime     @default(now())

  @@map("asset_depreciation_schedules")
}

model Budget {
  id              String          @id @default(uuid())
  companyId       String
  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fiscalYearId    String
  fiscalYear      FiscalYear      @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)
  accountId       String
  account         ChartOfAccounts @relation(fields: [accountId], references: [id], onDelete: Cascade)
  allocatedAmount Float
  utilizedAmount  Float           @default(0.0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([companyId, fiscalYearId, accountId])
  @@map("budgets")
}

model BankAccount {
  id             String          @id @default(uuid())
  companyId      String
  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  accountName    String
  accountNumber  String
  bankName       String
  glAccountId    String
  glAccount      ChartOfAccounts @relation(fields: [glAccountId], references: [id], onDelete: Cascade)
  status         String          @default("ACTIVE")
  statements     BankStatement[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([companyId, accountNumber])
  @@map("bank_accounts")
}

model BankStatement {
  id             String              @id @default(uuid())
  bankAccountId  String
  bankAccount    BankAccount         @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  statementDate  DateTime
  openingBalance Float
  closingBalance Float
  status         String              @default("DRAFT") // "DRAFT" | "RECONCILED"
  lines          BankStatementLine[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@map("bank_statements")
}

model BankStatementLine {
  id                  String        @id @default(uuid())
  bankStatementId     String
  bankStatement       BankStatement @relation(fields: [bankStatementId], references: [id], onDelete: Cascade)
  transactionDate     DateTime
  description         String
  amount              Float         // positive=deposit, negative=withdrawal
  reference           String?
  isReconciled        Boolean       @default(false)
  matchedJournalEntryId String?
  reconciledAt        DateTime?
  createdAt           DateTime      @default(now())

  @@map("bank_statement_lines")
}

