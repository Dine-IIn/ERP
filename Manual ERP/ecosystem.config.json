{
  "apps": [
    {
      "name": "erp-backend",
      "script": "dist/index.js",
      "cwd": "./backend",
      "instances": "max",
      "exec_mode": "cluster",
      "autorestart": true,
      "watch": false,
      "max_memory_restart": "1G",
      "env": {
        "NODE_ENV": "development",
        "PORT": 5000,
        "CENTRAL_SERVICES_URL": "http://localhost:6000"
      },
      "env_production": {
        "NODE_ENV": "production",
        "PORT": 5000,
        "FRONTEND_URL": "https://erp.anbindustries.com",
        "CENTRAL_SERVICES_URL": "https://centeralservice.anbindustries.com"
      }
    }
  ]
}
