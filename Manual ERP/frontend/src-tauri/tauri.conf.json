{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ERP",
  "version": "0.0.3",
  "identifier": "com.ERP.enterprise",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "corepack pnpm dev",
    "beforeBuildCommand": "corepack pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "ERP Console",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://centeralservice.anbindustries.com/api/updater/{{target}}/{{current_version}}"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI0Q0I5OUZDQjQ3MkMxRDkKUldUWndYSzAvSm5MSk9MYTIrS0gzQ05IZFpaeDhNQVlzRHFuaTBKSTNwcFZJMnZHM0lsc0p4V2IK",
      "dangerousInsecureTransportProtocol": true
    }
  }
}