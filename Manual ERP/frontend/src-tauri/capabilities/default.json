{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "updater:default",
    "http:default",
    {
      "identifier": "http:allow-fetch",
      "scope": {
        "allow": [
          "http://localhost:5000/*",
          "http://localhost:6001/*",
          "https://license.xyz.com/*",
          "https://updates.xyz.com/*",
          "https://*.xyz.com/*"
        ]
      }
    },
    {
      "identifier": "http:allow-fetch-send",
      "scope": {
        "allow": [
          "http://localhost:5000/*",
          "http://localhost:6001/*",
          "https://license.xyz.com/*",
          "https://updates.xyz.com/*",
          "https://*.xyz.com/*"
        ]
      }
    },
    {
      "identifier": "http:allow-fetch-read-body",
      "scope": {
        "allow": [
          "http://localhost:5000/*",
          "http://localhost:6001/*",
          "https://license.xyz.com/*",
          "https://updates.xyz.com/*",
          "https://*.xyz.com/*"
        ]
      }
    }
  ]
}
