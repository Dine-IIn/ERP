{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "updater:default",
    "http:default",
    {
      "identifier": "http:allow-fetch",
      "allow": [
        "http://localhost:5000/*",
        "http://localhost:6000/*",
        "http://localhost:6001/*",
        "https://clients3.google.com/*",
        "https://centeralservice.anbindustries.com/*",
        "https://erp.anbindustries.com/*",
        "https://api.anbindustries.com/*"
      ]
    },
    {
      "identifier": "http:allow-fetch-send",
      "allow": [
        "http://localhost:5000/*",
        "http://localhost:6000/*",
        "http://localhost:6001/*",
        "https://clients3.google.com/*",
        "https://centeralservice.anbindustries.com/*",
        "https://erp.anbindustries.com/*",
        "https://api.anbindustries.com/*"
      ]
    },
    {
      "identifier": "http:allow-fetch-read-body",
      "allow": [
        "http://localhost:5000/*",
        "http://localhost:6000/*",
        "http://localhost:6001/*",
        "https://clients3.google.com/*",
        "https://centeralservice.anbindustries.com/*",
        "https://erp.anbindustries.com/*",
        "https://api.anbindustries.com/*"
      ]
    }
  ]
}