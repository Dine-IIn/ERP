generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Platform {
  id        String   @id @default(uuid())
  name      String   @default("NexaERP")
  version   String   @default("1.0.0")
  createdAt DateTime @default(now())
}

model Company {
  id           String    @id @default(uuid())
  name         String
  slug         String    @unique
  email        String    @unique
  phone        String?
  logo         String?
  primaryColor String    @default("#3B5BFF")
  dbName       String    @unique
  dbHost       String    @default("localhost")
  isActive     Boolean   @default(true)
  isSelfHosted Boolean   @default(false)
  planId       String
  plan         Plan      @relation(fields: [planId], references: [id])
  subscriptions Subscription[]
  featureFlags CompanyFeatureFlag[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?
}

model Plan {
  id           String    @id @default(uuid())
  name         String    @unique
  displayName  String
  priceMonthly Float
  priceYearly  Float
  maxUsers     Int       @default(10)
  maxStorage   Int       @default(5120)
  features     String[]
  isActive     Boolean   @default(true)
  companies    Company[]
  createdAt    DateTime  @default(now())
}

model Subscription {
  id                 String   @id @default(uuid())
  companyId          String
  company            Company  @relation(fields: [companyId], references: [id])
  planId             String
  status             String
  trialEndsAt        DateTime?
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model CompanyFeatureFlag {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  feature   String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([companyId, feature])
}

model PlatformUser {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
