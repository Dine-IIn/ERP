{
  "compilerOptions": {
    "target": "ES2022",

    "module": "CommonJS",
    "moduleResolution": "Node",

    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    "strict": true,
    "esModuleInterop": true,

    "skipLibCheck": true,

    "outDir": "./dist",
    "rootDir": "./src",

    "baseUrl": "./",

    "noEmit": false
  },

  "include": [ "src/**/*.ts" ],

  "exclude": [
    "node_modules",
    "dist"
  ]
}